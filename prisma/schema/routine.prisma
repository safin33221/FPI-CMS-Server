model ClassRoutine {
  id String @id @default(uuid())

  subjectAssignmentId String
  subjectAssignment SubjectAssignment @relation(fields: [subjectAssignmentId], references: [id])

  teacherId String
  teacher Teacher @relation(fields: [teacherId], references: [id])

  roomId String
  room Room @relation(fields: [roomId], references: [id])

  academicSessionId String
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])

  day Weekday
  startTime String
  endTime String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicSessionId, day, startTime, endTime])
  @@index([teacherId, academicSessionId, day])
  @@index([roomId, academicSessionId, day])
}
